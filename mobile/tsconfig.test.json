{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src",
    "outDir": ".test-build",
    "noEmit": false
  },
  "include": [
    "src/types/**/*.ts",
    "src/services/alerts/**/*.ts",
    "!src/services/alerts/expo-sqlite-driver.ts",
    "!src/services/alerts/index.ts"
  ]
}
