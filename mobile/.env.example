# Copy this file to `.env` (which is git-ignored) and fill in local values.
# Expo inlines EXPO_PUBLIC_* variables into the bundle at build time, so never
# put secrets here.

# Backend ORIGIN only — do NOT include `/api/v1`; the app appends it.
# Examples:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000        (Android emulator)
#   EXPO_PUBLIC_API_BASE_URL=https://api.okoa.example
EXPO_PUBLIC_API_BASE_URL=
