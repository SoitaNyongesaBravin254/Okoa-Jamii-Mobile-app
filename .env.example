# Okoa Jamii - environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_user>:<password>@<cluster-host>/<database-name>

# --- Application (required at startup) --------------------------------
# development | test | production
NODE_ENV=development
PORT=4000

# JWT signing secret (REQUIRED, minimum 32 characters).
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters-here

# Access-token lifetime. Format: <positive integer><unit>, unit one of
# s | m | h | d | w (e.g. 30m, 12h, 7d, 4w). Range: 1 minute .. 30 days.
# Bare numbers such as "3600" are REJECTED - they are ambiguous and would be
# read as milliseconds by jsonwebtoken.
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma-separated for several).
# Exact origins only: scheme + host + optional port (1-65535), no path, no
# wildcard, no duplicate entries.
#   e.g. https://app.example.com,http://localhost:3000
# Empty = CORS middleware not mounted (development/test only).
# REQUIRED when NODE_ENV=production: startup fails with
#   CORS_ORIGIN: required_in_production
# instead of silently serving a disabled allow-list. "*" is never accepted.
CORS_ORIGIN=

# Reverse-proxy trust -> Express `app.set('trust proxy', ...)`, which decides
# the client IP used by IP-based rate limiting. Safe default: unset/0/false
# (direct connection; X-Forwarded-For is ignored and cannot spoof an IP).
# Behind a load balancer, set ONE of:
#   1                      trusted hops between the client and this process
#                          (1 for a single reverse proxy in front of us)
#   10.0.0.0/8,127.0.0.1  exact proxy IPs / CIDR ranges that may speak for
#                          a client (preferred: only these peers are trusted)
# "true" and "*" are REJECTED: they let any client forge X-Forwarded-For and
# bypass rate limiting. So is a "/0" subnet (blind trust by another name).
# Values are 0-10, or a comma-separated IP/CIDR list (no leading-zero
# prefixes such as /08).
TRUST_PROXY=

# debug | info | warn | error
LOG_LEVEL=info

# bcrypt cost (4-15)
BCRYPT_ROUNDS=12

# How long a database connection attempt may take before failing (ms)
SERVER_SELECTION_TIMEOUT_MS=5000

# Maximum JSON request body size (bytes)
MAX_REQUEST_BODY_BYTES=65536

# --- Tests ------------------------------------------------------------
# ISOLATED test database only; the database name must contain "test".
# Integration tests refuse to run if this equals MONGODB_URI.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/okoa_test

# Set to 1 to run the suite that connects to the REAL Atlas cluster via
# MONGODB_URI (read-only ping). Default is 0: those tests self-skip.
RUN_ATLAS_TESTS=0
